# context-harness-mcp environment variables
# Copy this file to .env and fill in real values before running locally.
# Never commit .env — it is listed in .gitignore.

# Postgres connection string (required). Works with any Postgres + pgvector
# instance: Supabase, Neon, AWS RDS, self-hosted, or a local container.
# Railway, Render, Fly, and Heroku auto-populate DATABASE_URL when they
# provision Postgres — if your host does that, you don't need to set this
# manually in the hosting dashboard.
#
# Legacy name SUPABASE_DB_URL is still accepted for one release (deprecated;
# the server prints a stderr warning when it is used). Rename to DATABASE_URL.
DATABASE_URL=postgres://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require

# MCP transport: "stdio" for local Claude Code stdio integration, "http" for
# docker-compose / Render (streamable-http via mcp-go).
MCP_TRANSPORT=stdio

# Listen address for the HTTP transport (ignored when MCP_TRANSPORT=stdio).
MCP_HTTP_ADDR=:7654

# Log verbosity: debug, info, warn, error.
LOG_LEVEL=info

# Path to the ONNX shared library directory.
# In the Docker image this is /usr/local/lib (set via LD_LIBRARY_PATH in the Dockerfile).
# On macOS/Linux host installs, point to wherever libonnxruntime.so lives.
# Consumed by fastembed-go (PR-5).
ONNX_RUNTIME_PATH=/usr/local/lib

# Secret detection mode for the Content Filter (Layer 2 — secrets).
# Valid values:
#   reject (default) — calls containing detected credentials are aborted and
#                      policy/secret-detected is returned to the client.
#   redact           — matched secret spans are replaced with [REDACTED] in-place
#                      and the call proceeds. Analogous to OTEL exporters that
#                      scrub PII rather than dropping the span.
# Any other value causes a startup error (fail-fast; no silent fallback).
SECRET_MODE=reject

# context-harness-mcp environment variables
# Copy this file to .env and fill in real values before running locally.
# Never commit .env — it is listed in .gitignore.

# Postgres connection string (required). Works with any Postgres + pgvector
# instance: Supabase, Neon, AWS RDS, self-hosted, or a local container.
# Railway, Render, Fly, and Heroku auto-populate DATABASE_URL when they
# provision Postgres — if your host does that, you don't need to set this
# manually in the hosting dashboard.
#
# Legacy name SUPABASE_DB_URL is still accepted for one release (deprecated;
# the server prints a stderr warning when it is used). Rename to DATABASE_URL.
DATABASE_URL=postgres://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require

# MCP transport: "stdio" for local Claude Code stdio integration, "http" for
# docker-compose / cloud (streamable-http via mcp-go).
MCP_TRANSPORT=stdio

# HTTP listen port (ignored when MCP_TRANSPORT=stdio). On PaaS platforms
# (Railway / Heroku / Fly / Render) the platform sets PORT automatically and
# routes its healthcheck to the same port — you do NOT need to set this
# yourself there. Set it only for local docker-compose or bare-metal runs
# where you want a port other than the 7654 default. The server reads PORT;
# pass -addr=:N as a CLI flag for fully explicit overrides.
# PORT=7654

# Log verbosity: debug, info, warn, error.
LOG_LEVEL=info

# Path to the ONNX shared library directory.
# In the Docker image this is /usr/local/lib (set via LD_LIBRARY_PATH in the Dockerfile).
# On macOS/Linux host installs, point to wherever libonnxruntime.so lives.
# Consumed by fastembed-go (PR-5).
ONNX_RUNTIME_PATH=/usr/local/lib

# Secret detection mode for the Content Filter (Layer 2 — secrets).
# Valid values:
#   reject (default) — calls containing detected credentials are aborted and
#                      policy/secret-detected is returned to the client.
#   redact           — matched secret spans are replaced with [REDACTED] in-place
#                      and the call proceeds. Analogous to OTEL exporters that
#                      scrub PII rather than dropping the span.
# Any other value causes a startup error (fail-fast; no silent fallback).
SECRET_MODE=reject

# ---------------------------------------------------------------------------
# Observability (Axiom via OpenTelemetry OTLP/HTTP) — see docs/observability.md
# ---------------------------------------------------------------------------

# Master switch. Set to "true" to enable the OpenTelemetry SDK. When "false"
# (default) the SDK is a no-op: no connections opened, no overhead.
# WARNING: setting this to "true" before PR-F is merged will cause a boot
# failure (boot guard — see AC-A.8). Flip to "true" only after PR-F is in
# and you have verified the smoke test passes.
CH_OBSERVABILITY_ENABLED=false

# OTLP/HTTP endpoint for traces, logs, and metrics. For Axiom set this to
# "https://api.axiom.co" (no trailing slash; the SDK appends /v1/traces etc.).
# For a local OpenTelemetry Collector use "http://localhost:4318".
OTEL_EXPORTER_OTLP_ENDPOINT=https://api.axiom.co

# Axiom API token with "Ingest" scope only (never "Query" or "Manage").
# The server builds OTEL_EXPORTER_OTLP_HEADERS at runtime from this value
# and AXIOM_DATASET below. Never commit a real token here.
AXIOM_TOKEN=your-axiom-token-here

# Axiom dataset name. Per the approved Opción C: one dataset "context-harness-mcp"
# for all signals (traces + logs + metrics). The second free-tier slot is reserved
# for future projects.
AXIOM_DATASET=context-harness-mcp

# Override the service name embedded in all telemetry (default: "context-harness-mcp").
# Useful if you run multiple instances and want to distinguish them.
OTEL_SERVICE_NAME=context-harness-mcp

# Additional resource attributes injected by the deploy pipeline.
# Format: comma-separated key=value pairs.
# The deploy pipeline should inject deployment.environment and service.version.
# Example: "deployment.environment=production,service.version=abc1234"
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=local,service.version=dev

# Sampler selection. "parentbased_traceidratio" is the default and the only
# approved value for this service. Do not change unless the operator explicitly
# decides to switch sampling strategy.
OTEL_TRACES_SAMPLER=parentbased_traceidratio

# Sampling ratio (0.0–1.0). Start at 1.0 to capture 100% during the first
# 60-day baseline period. Downsample to 0.1 when traffic patterns are clear
# (trigger: >50% of monthly Axiom budget used in any single week).
OTEL_TRACES_SAMPLER_ARG=1.0

# OTel SDK-level kill-switch. The server sets this automatically for the
# stdio transport (PR-H). You can also set it manually to disable the SDK
# without changing CH_OBSERVABILITY_ENABLED (useful for quick troubleshooting
# without a restart of the deployment pipeline).
# OTEL_SDK_DISABLED=false

# Log level filter applied to the OTel Logs exporter (stdout logging is
# unaffected). Valid values: debug, info, warn, error. Default: info.
# Only set to "debug" for short troubleshooting sessions — debug logs can
# include query parameters and increase Axiom ingestion volume significantly.
OTEL_LOG_LEVEL=info
